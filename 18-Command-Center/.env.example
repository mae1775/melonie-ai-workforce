# Optional. server.py reads process environment; it does not auto-load .env files.
MWOS_PORT=8765
# Dedicated reviewed Postgres login; never n8n, postgres or service_role credentials.
MWOS_DATABASE_DSN=postgresql://workforce_command_center_reader:REPLACE_PASSWORD@REPLACE_HOST:5432/postgres
MWOS_WORKSPACE_IDS=REPLACE_WITH_AUTHORIZED_WORKSPACE_UUID
# Keep false during preparation; UUID configuration alone proves no authorization.
MWOS_READONLY_VERIFIED=false
# agents and runtime_controls are global metadata; separately authorize their disclosure.
MWOS_GLOBAL_METADATA_VERIFIED=false
